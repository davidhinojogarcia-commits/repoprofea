# Clave del servicio de análisis documental existente (solo servidor; Tutor PROFEA no la utiliza)
GEMINI_API_KEY=

# Secreto exclusivamente servidor para confirmar acciones sensibles del Tutor PROFEA local.
TUTOR_CONFIRMATION_SECRET=

# Supabase frontend configuration. Never put the secret/service-role key here.
VITE_SUPABASE_URL=https://oanurwzoymkmwmxoyzqi.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor (Vercel Functions). Nunca usar VITE_ ni exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enables direct Google Calendar OAuth/API creation.
# Without it, the app uses the Google Calendar Web fallback.
VITE_GOOGLE_CLIENT_ID=

# Supabase Edge Function secrets for inventory sharing invitations.
# Configure these with Supabase secrets; never expose them with a VITE_ prefix.
RESEND_API_KEY=
INVENTORY_INVITE_FROM_EMAIL=
APP_URL=https://gestionprofea.vercel.app/


# Actas: solo servidor. Mantener la cuenta Groq en Free, sin método de pago.
# La aplicación no puede verificar el plan de facturación de una clave.
VISIT_WRITING_PROVIDER=groq
GROQ_API_KEY=
# Default: openai/gpt-oss-20b. No se usa VISIT_WRITING_MODEL para Groq.
VISIT_WRITING_GROQ_MODEL=
# Integración anterior solo mediante selección explícita: gemini.
VISIT_WRITING_MODEL=
