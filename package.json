{
  "name": "sistema-contratación-profea_dhg",
  "private": true,
  "version": "1.19.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test:prevention": "node --import tsx scripts/testPrevention.ts && node scripts/testPreventionSql.mjs && node scripts/runPreventionUi.mjs",
    "test:mandatory-signatures": "tsx scripts/testMandatorySignatureAnchoring.ts",
    "test:relation-ordering": "tsx scripts/testRelationExportOrdering.ts",
    "test:mandatory-worker-detection": "tsx scripts/testMandatoryWorkerDetection.ts",
    "test:modal-layering": "tsx scripts/testModalLayering.ts",
    "test:theme-contrast": "tsx scripts/testThemeContrast.ts",
    "test:global-modal-stack": "tsx scripts/testGlobalModalStack.ts",
    "test:global-modal-audit": "tsx scripts/testGlobalModalAudit.ts",
    "test:mandatory-traceability-v2": "tsx scripts/testMandatoryTraceabilityV2.ts",
    "test:mandatory-traceability-integration-v2": "tsx scripts/testMandatoryTraceabilityIntegrationV2.ts",
    "test:mandatory-traceability-sql-v2": "node scripts/testMandatoryTraceabilitySqlV2.mjs",
    "test:mandatory-traceability-e2e-v2": "node scripts/testMandatoryTraceabilityE2E.mjs",
    "validate:mandatory-traceability-v2": "node scripts/validateMandatoryTraceabilityReleaseV2.mjs",
    "test:mandatory-missing-worker": "node scripts/testMandatoryMissingWorkerRecovery.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@supabase/supabase-js": "^2.57.4",
    "date-fns": "^4.1.0",
    "exceljs": "4.4.0",
    "express": "^5.2.1",
    "jspdf": "2.5.1",
    "jspdf-autotable": "3.8.1",
    "lucide-react": "^0.563.0",
    "mammoth": "^1.12.2",
    "motion": "^12.42.0",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.10.1",
    "tesseract.js": "^6.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.1",
    "jsdom": "26.1.0",
    "tsx": "^4.22.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
