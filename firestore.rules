rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // New canonical per-user application database.
    // Every account has an isolated state collection keyed by Firebase UID.
    match /user_data/{userId}/state/{stateKey} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User profile data belongs only to the authenticated owner.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{allChildren=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Legacy workspace/sync collections remain available only to signed-in users.
    // The application is migrating away from manual synchronization to user_data.
    match /workspaces/{workspaceId} {
      allow read, write: if request.auth != null;
      match /{allChildren=**} {
        allow read, write: if request.auth != null;
      }
    }

    match /email_vaults/{emailKey} {
      allow read, write: if request.auth != null;
      match /{allChildren=**} {
        allow read, write: if request.auth != null;
      }
    }

    match /sync_groups/{groupId} {
      allow read, write: if request.auth != null;
      match /{allChildren=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
