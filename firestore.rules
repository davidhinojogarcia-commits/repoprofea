rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }
    function active() {
      return signedIn()
        && request.auth.token.role in ['admin', 'user']
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    function moduleFor(collectionName) {
      return collectionName == 'workers' || collectionName == 'trash' ? 'trabajadores' :
             collectionName == 'works' || collectionName == 'obras' ? 'obras' :
             collectionName == 'medicalExams' || collectionName == 'recognitions' || collectionName == 'reconocimientos' ? 'reconocimientos' :
             collectionName == 'subcontractors' || collectionName == 'subcontratas' ? 'subcontratas' :
             collectionName == 'appointments' || collectionName == 'citas' ? 'citas' :
             collectionName == 'contracts' || collectionName == 'contratos' ? 'contratacion' :
             '';
    }

    function hasModule(collectionName, action) {
      return isAdmin()
        || (active()
          && moduleFor(collectionName) != ''
          && get(/databases/$(database)/documents/userPermissions/$(request.auth.uid)).data.modules[moduleFor(collectionName)][action] == true);
    }

    function shared(resourceType, resourceId, action) {
      return active()
        && get(/databases/$(database)/documents/dataPermissions/$(resourceType + '_' + resourceId + '_' + request.auth.uid)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/dataPermissions/$(resourceType + '_' + resourceId + '_' + request.auth.uid)).data[action] == true;
    }

    function owner() { return resource.data.ownerId == request.auth.uid; }
    function incomingOwner() { return request.resource.data.ownerId == request.auth.uid; }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && request.resource.data.active == resource.data.active
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy);
    }

    match /userPermissions/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    match /userSettings/{uid} {
      allow read: if isAdmin() || (active() && request.auth.uid == uid);
      allow create, update: if isAdmin() || (active() && request.auth.uid == uid && request.resource.data.ownerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /dataPermissions/{permissionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if active()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.action in ['LOGIN', 'CREATE', 'UPDATE', 'DELETE', 'CREATE_USER', 'UPDATE_USER', 'DELETE_USER', 'UPDATE_PERMISSIONS']
        && request.resource.data.resourceId is string;
      allow update, delete: if false;
    }

    match /{collection}/{id} {
      allow read: if hasModule(collection, 'read') && (isAdmin() || owner() || shared(collection, id, 'canRead'));
      allow create: if isAdmin() || (hasModule(collection, 'create') && incomingOwner());
      allow update: if isAdmin()
        || (active() && hasModule(collection, 'update')
          && (owner() || shared(collection, id, 'canUpdate'))
          && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if isAdmin() || (active() && hasModule(collection, 'delete') && (owner() || shared(collection, id, 'canDelete')));
    }

    match /workspaces/{workspaceId}/{document=**} { allow read, write: if false; }
    match /accounts/{accountId} { allow read, write: if false; }
    match /email_vaults/{emailKey}/{document=**} { allow read, write: if false; }
    match /sync_groups/{groupId}/{document=**} { allow read, write: if false; }
  }
}
