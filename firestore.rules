rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Shared Workspaces & Multi-Device Sync
    match /workspaces/{workspaceId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // User Accounts & Multi-device Sync
    match /users/{userId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // Email-based Sync Vaults
    match /email_vaults/{emailKey} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // Legacy Sync Groups
    match /sync_groups/{groupId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // Global fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

